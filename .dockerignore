# CP2 — Các file không đưa vào Docker build context.
#
# Không đưa secret, môi trường Python cục bộ,
# lịch sử Git hoặc cache vào image.

# Biến môi trường có thể chứa secret.
.env
.env.*

# Cho phép giữ lại file cấu hình mẫu.
!.env.example

# Lịch sử Git.
.git

# Virtual environment trên máy phát triển.
.venv
venv

# Python cache.
**/__pycache__
**/*.pyc
.pytest_cache

# Các file có thể chứa khóa riêng.
*.pem
*.key

# Ảnh minh chứng không cần thiết khi chạy service.
screenshots